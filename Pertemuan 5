        "# Soal 2: PLTS Atap Rumah\n",
        "jumlah_panel = 12\n",
        "daya_per_panel = 450 # Watt-peak (Wp)\n",
        "jam_penyinaran = 5\n",
        "efisiensi = 0.8\n",
        "kebutuhan_harian_kwh = 25\n",
        "tarif_listrik = 1444.70\n",
        "\n",
        "# 1. Energi yang dihasilkan per hari (kWh)\n",
        "energi_harian_wh = jumlah_panel * daya_per_panel * jam_penyinaran * efisiensi\n",
        "energi_harian_kwh = energi_harian_wh / 1000\n",
        "\n",
        "# 2. Energi per bulan (30 hari) dan nilai rupiahnya\n",
        "energi_bulan_kwh = energi_harian_kwh * 30\n",
        "nilai_rupiah_bulan = energi_bulan_kwh * tarif_listrik\n",
        "\n",
        "# 3. Kekurangan energi per hari terhadap kebutuhan\n",
        "kekurangan_energi = kebutuhan_harian_kwh - energi_harian_kwh\n",
        "\n",
        "# 4. Apakah PLTS sudah mencukupi kebutuhan rumah?\n",
        "plts_cukup = energi_harian_kwh >= kebutuhan_harian_kwh\n",
        "\n",
        "print(\"--- SOAL 2 ---\")\n",
        "print(f\"Energi per Hari      : {energi_harian_kwh:.2f} kWh\")\n",
        "print(f\"Energi per Bulan     : {energi_bulan_kwh:.2f} kWh\")\n",
        "print(f\"Nilai Rupiah Listrik : Rp {nilai_rupiah_bulan:,.2f}\")\n",
        "print(f\"Kekurangan Energi    : {kekurangan_energi:.2f} kWh/hari\")\n",
        "print(f\"PLTS Mencukupi?      : {plts_cukup}\\n\")"

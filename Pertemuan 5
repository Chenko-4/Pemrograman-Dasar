        "# Soal 3: Generator Diesel dan Rugi Kabel\n",
        "daya_generator_kw = 200\n",
        "jam_operasi = 8\n",
        "konsumsi_per_kwh = 0.25 # liter/kWh\n",
        "harga_solar = 13500\n",
        "kapasitas_tangki = 1000 # liter\n",
        "arus = 20 # Ampere\n",
        "hambatan = 0.5 # Ohm\n",
        "\n",
        "# 1. Energi yang dibangkitkan per hari (kWh)\n",
        "energi_dibangkitkan_kwh = daya_generator_kw * jam_operasi\n",
        "\n",
        "# 2. Kebutuhan solar per hari dan biayanya\n",
        "kebutuhan_solar_harian = energi_dibangkitkan_kwh * konsumsi_per_kwh\n",
        "biaya_solar_harian = kebutuhan_solar_harian * harga_solar\n",
        "\n",
        "# 3. Berapa hari penuh tangki cukup dan sisa solar\n",
        "hari_penuh = int(kapasitas_tangki // kebutuhan_solar_harian)\n",
        "sisa_solar = kapasitas_tangki % kebutuhan_solar_harian\n",
        "\n",
        "# 4. Rugi daya pada kabel (P = I^2 * R)\n",
        "rugi_daya = (arus ** 2) * hambatan\n",
        "\n",
        "# 5. Apakah rugi kabel tergolong tinggi? (> 150 W DAN arus >= 20 A)\n",
        "rugi_tinggi = (rugi_daya > 150) and (arus >= 20)\n",
        "\n",
        "print(\"--- SOAL 3 ---\")\n",
        "print(f\"Energi Dibangkitkan  : {energi_dibangkitkan_kwh:.2f} kWh/hari\")\n",
        "print(f\"Kebutuhan Solar/Hari : {kebutuhan_solar_harian:.2f} liter\")\n",
        "print(f\"Biaya Solar Harian   : Rp {biaya_solar_harian:,.2f}\")\n",
        "print(f\"Lama Tangki Cukup    : {hari_penuh} hari penuh\")\n",
        "print(f\"Sisa Solar di Tangki : {sisa_solar:.2f} liter\")\n",
        "print(f\"Rugi Daya Kabel      : {rugi_daya:.2f} Watt\")\n",
        "print(f\"Rugi Kabel Tinggi?   : {rugi_tinggi}\")"

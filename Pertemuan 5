        "# Soal 1: Belanja Buku\n",
        "jumlah_buku = 7\n",
        "harga_per_buku = 18500\n",
        "persentase_diskon = 0.10\n",
        "uang_bayar = 150000\n",
        "\n",
        "# 1. Total belanja, besar diskon, dan jumlah harus dibayar\n",
        "total_belanja = jumlah_buku * harga_per_buku\n",
        "besar_diskon = total_belanja * persentase_diskon\n",
        "jumlah_harus_dibayar = total_belanja - besar_diskon\n",
        "\n",
        "# 2. Uang kembalian\n",
        "uang_kembalian = uang_bayar - jumlah_harus_dibayar\n",
        "\n",
        "# 3. Patungan 4 orang (bilangan bulat) dan sisa\n",
        "iuran_per_orang = int(jumlah_harus_dibayar) // 4\n",
        "sisa_rupiah = int(jumlah_harus_dibayar) % 4\n",
        "\n",
        "# 4. Apakah uang Budi cukup?\n",
        "uang_cukup = uang_bayar >= jumlah_harus_dibayar\n",
        "\n",
        "print(\"--- SOAL 1 ---\")\n",
        "print(f\"Total Belanja        : Rp {total_belanja:,.2f}\")\n",
        "print(f\"Besar Diskon         : Rp {besar_diskon:,.2f}\")\n",
        "print(f\"Harus Dibayar        : Rp {jumlah_harus_dibayar:,.2f}\")\n",
        "print(f\"Uang Kembalian       : Rp {uang_kembalian:,.2f}\")\n",
        "print(f\"Iuran per Orang (4x) : Rp {iuran_per_orang:,}\")\n",
        "print(f\"Sisa Rupiah          : Rp {sisa_rupiah:,}\")\n",
        "print(f\"Apakah Uang Cukup?   : {uang_cukup}\\n\")"
      ]
    },

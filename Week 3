        "# Tujuan Program : Menghitung efisiensi termal unit pembangkit\n",
        "#                  berdasarkan energi input dan output (MJ)\n",
        "#                  serta menampilkan hasil pembulatan 2 desimal.\n",
        "# =========================================================\n",
        "\n",
        "# Langkah 1: Menerima masukan nilai energi input dan output dari pengguna\n",
        "energi_input = float(input(\"Masukkan nilai energi input (MJ): \"))\n",
        "energi_output = float(input(\"Masukkan nilai energi output (MJ): \"))\n",
        "\n",
        "# Langkah 2: Menghitung efisiensi termal dengan tanda kurung sesuai precedence\n",
        "efisiensi = (energi_output / energi_input) * 100\n",
        "\n",
        "# Langkah 3: Menampilkan hasil efisiensi dengan f-string dibulatkan 2 desimal\n",
        "print(f\"Efisiensi termal unit pembangkit: {efisiensi:.2f}%\")"

        "# =========================================================\n",
        "# Nama           : Chenko Razin Rabbani\n",
        "# NIM            : 4232501052\n",
        "# Tanggal        : 22 September 2026\n",
        "# Tujuan Program : Mengecek kelayakan mengemudi dengan operator logika\n",
        "#                  serta mengimplementasikan latihan operator precedence\n",
        "# =========================================================\n",
        "\n",
        "# Langkah 1: Menerima input dari pengguna\n",
        "umur = int(input(\"Masukkan umur Anda: \"))\n",
        "input_sim = input(\"Apakah punya SIM? (ketik 'True' atau 'False'): \").strip()\n",
        "punya_sim = input_sim.lower() == 'true'\n",
        "\n",
        "# Langkah 2: Pengecekan syarat boleh mengemudi\n",
        "boleh_mengemudi = (umur >= 17) and punya_sim\n",
        "print(f\"Boleh mengemudi sendiri: {boleh_mengemudi}\")\n",
        "\n",
        "# Langkah 3: Latihan Operator Precedence (Menggunakan Tanda Kurung)\n",
        "# Contoh: Mendapatkan promo pengemudi jika boleh mengemudi DAN (umur > 50 ATAU umur < 20)\n",
        "dapat_promo = boleh_mengemudi and (umur > 50 or umur < 20)\n",
        "print(f\"Status mendapat promo khusus pengemudi: {dapat_promo}\")"
      ],

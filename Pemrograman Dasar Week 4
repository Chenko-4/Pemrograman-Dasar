        "# PROGRAM KALKULATOR PEMBELIAN BARANG ELEKTRONIK\n",
        "\n",
        "# Global Scope\n",
        "PAJAK_RATE = 0.11 # Pajak PPN 11%\n",
        "\n",
        "def hitung_pembayaran():\n",
        "    # Local Scope\n",
        "    print(\"=== PROGRAM KASIR TOKO ELEKTRONIK ===\")\n",
        "\n",
        "    # 1. Fungsi Input\n",
        "    nama_barang = input(\"Masukkan Nama Barang : \")\n",
        "    harga_satuan = float(input(\"Masukkan Harga Satuan (Rp) : \"))\n",
        "    jumlah_beli = int(input(\"Masukkan Jumlah Beli : \"))\n",
        "\n",
        "    # 2. Operasi Aritmatika\n",
        "    subtotal = harga_satuan * jumlah_beli\n",
        "    pajak = subtotal * PAJAK_RATE\n",
        "    total_bayar = subtotal + pajak\n",
        "\n",
        "    # 3. Fungsi Output\n",
        "    print(\"\\n\" + \"=\"*35)\n",
        "    print(\"        RINCIAN PEMBAYARAN        \")\n",
        "    print(\"=\"*35)\n",
        "    print(f\"Nama Barang   : {nama_barang}\")\n",
        "    print(f\"Subtotal      : Rp {subtotal:,.2f}\")\n",
        "    print(f\"PPN (11%)     : Rp {pajak:,.2f}\")\n",
        "    print(\"-\" * 35)\n",
        "    print(f\"Total Bayar   : Rp {total_bayar:,.2f}\")\n",
        "    print(\"=\"*35)\n",
        "\n",
        "# Memanggil Fungsi\n",
        "hitung_pembayaran()"
      ],
